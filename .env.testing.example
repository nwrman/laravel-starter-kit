# Template for .env.testing, which is gitignored: each checkout writes its own from this file.
#
# Laravel loads .env.testing INSTEAD of .env whenever APP_ENV=testing, which phpunit.xml forces.
# It replaces .env rather than merging with it, so every key the suite needs is here.

APP_NAME="Laravel"
APP_ENV=testing
# Throwaway key, committed on purpose: this environment only ever names a *_test database
# and holds nothing worth protecting. Never reuse it anywhere else.
APP_KEY=base64:KUPhv6upsgbTvNnG+b2az0CG4Gowblps3Q+UGfj6pXo=
APP_DEBUG=true
APP_URL=http://localhost

# Meta description + Open Graph/Twitter share description. Keep under ~160 chars.
APP_DESCRIPTION="A Laravel application."

# Throwaway too, for the same reason; fixed so passkey user handles do not shift mid-suite.
PASSKEYS_USER_HANDLE_SECRET=00693dff08ef05475565bf62a8640f359e815722c09b256b886a058c661ca8ba

# imanghafoori/laravel-anypass config, you can sign in with any password
# to test a failing password use 1_wrong_pass
ANY_PASS=true
WRONG_ANY_PASS=1_wrong_pass

# Public registration. Defaults to on everywhere except production, so a
# production environment that forgets to declare it gets no signup rather than
# open signup. Set explicitly to be sure either way.
ALLOW_REGISTRATION=true

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# The test database. Its name must end in _test: Tests\TestCase refuses to run otherwise.
# Whatever writes .env.testing names it <app database>_test — composer create-project,
# herd.yml for a worktree, scripts/refresh-main.sh for the main checkout. CI rewrites the
# DB_* keys below with anchored sed (.github/workflows/tests.yml).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=laravel_starter_kit_test
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

TELEGRAM_API_BASE=https://api.telegram.org
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_MESSAGE_THREAD_ID=

VITE_APP_NAME="${APP_NAME}"

# Demo Data Artificial Latency (ms, 0 = disabled)
# Used by DemoDataService to simulate realistic loading delays for deferred props.
# Set to 0 in CI/testing (disabled automatically in the testing environment).
DEMO_LATENCY_CHARTS_MS=0
DEMO_LATENCY_FEED_MS=0
DEMO_LATENCY_TABLE_MS=0
DEMO_LATENCY_DETAIL_MS=0
