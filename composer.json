{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "nwrman/laravel-starter-kit",
    "type": "project",
    "description": "Laravel starter kit with Inertia v3, React 19, TanStack, and demo patterns",
    "license": "MIT",
    "authors": [
        {
            "name": "Jonathan H. Fern\u00e1ndez",
            "email": "nwrman@gmail.com"
        }
    ],
    "require": {
        "php": "^8.5.0",
        "filament/filament": "^5.7.6",
        "inertiajs/inertia-laravel": "^3.0.0-beta",
        "laravel/fortify": "^1.38",
        "laravel/framework": "^13.25.0",
        "laravel/wayfinder": "^0.1.23",
        "league/flysystem-aws-s3-v3": "^3.35.2",
        "nunomaduro/essentials": "^1.2.0",
        "nwrman/laravel-toolkit": "^0.4",
        "spatie/laravel-medialibrary": "^11.23.5"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.5.0",
        "fakerphp/faker": "^1.24.1",
        "imanghafoori/laravel-anypass": "^1.0.12",
        "larastan/larastan": "^3.10.0",
        "laravel/boost": "^2.5.3",
        "laravel/pail": "^1.2.7",
        "laravel/pao": "^1.1",
        "laravel/pint": "^1.30.5",
        "laravel/tinker": "^3.0.2",
        "mockery/mockery": "^1.6.12",
        "nunomaduro/collision": "^8.9.5",
        "pestphp/pest": "^5.3.2",
        "pestphp/pest-plugin-browser": "^5.1.2",
        "pestphp/pest-plugin-laravel": "^5.0.1",
        "pestphp/pest-plugin-type-coverage": "^5.0.3",
        "rector/rector": "^2.6.1",
        "roave/security-advisories": "dev-latest"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "bun install",
            "bun run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "bunx concurrently -c \"#c4b5fd,#fb7185,#fdba74\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"vp dev\" --names=queue,logs,vite --kill-others"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-install-cmd": [
            "@php artisan filament:sync-colors --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan clear",
            "@php artisan filament:sync-colors --ansi",
            "@php artisan boost:update --no-discover --no-interaction"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php -r \"file_exists('.env.testing') || copy('.env.testing.example', '.env.testing');\"",
            "@php -r '$db = strtolower(preg_replace(\"/[^A-Za-z0-9]+/\", \"_\", basename(getcwd()))); foreach ([\".env\" => $db, \".env.testing\" => $db.\"_test\"] as $file => $name) { file_put_contents($file, preg_replace(\"/^DB_DATABASE=.*$/m\", \"DB_DATABASE=\".$name, file_get_contents($file))); }'",
            "@php artisan key:generate --ansi",
            "@php artisan migrate --seed --force --graceful --ansi",
            "@php artisan migrate --env=testing --force --graceful --ansi",
            "@php artisan migrate:status --env=testing > /dev/null 2>&1 || php -r \"echo PHP_EOL . '\\033[33m  Postgres was not reachable. Start it (DBngin), then: php artisan migrate --seed && php artisan migrate --env=testing\\033[0m' . PHP_EOL;\"",
            "git init --quiet",
            "git add .",
            "git commit -m \"Initial commit\" --quiet",
            "@php -r \"echo PHP_EOL . '\\033[32m  Git repository initialized with initial commit.\\033[0m' . PHP_EOL;\""
        ],
        "update:requirements": [
            "composer bump",
            "@update:frontend"
        ],
        "update:frontend": [
            "bunx npm-check-updates -u"
        ],
        "lint:dirty": [
            "Composer\\Config::disableProcessTimeout",
            "node --experimental-strip-types resources/js/scripts/lint-dirty.ts"
        ],
        "lint": [
            "rector",
            "pint --parallel",
            "bun run lint"
        ],
        "test:type-coverage": "pest --type-coverage --min=100",
        "test:unit": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan toolkit:report --no-interaction --suite=unit --env=testing"
        ],
        "test:feature": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan toolkit:report --no-interaction --suite=feature --env=testing"
        ],
        "test:browser": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan toolkit:report --no-interaction --suite=browser --env=testing"
        ],
        "test:fast": [
            "Composer\\Config::disableProcessTimeout",
            "XDEBUG_MODE=coverage pest --parallel"
        ],
        "test:frontend": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan toolkit:report --no-interaction --suite=frontend --env=testing"
        ],
        "test:lint": [
            "pint --parallel --test",
            "rector --dry-run",
            "bun run test:lint"
        ],
        "test:types": [
            "phpstan",
            "bun run test:types"
        ],
        "test": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan toolkit:report --no-interaction --env=testing"
        ],
        "test:ci": [
            "@test:lint",
            "@test:types",
            "@test:type-coverage",
            "XDEBUG_MODE=\"coverage\" pest --parallel --coverage --exactly=100.0 --no-tia",
            "bun run test:coverage"
        ],
        "test:report": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan toolkit:report --env=testing"
        ],
        "test:retry": "@php artisan toolkit:retry --env=testing",
        "preflight": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan toolkit:preflight --env=testing"
        ],
        "optimize": [
            "@php artisan optimize",
            "@php artisan config:cache",
            "@php artisan event:cache",
            "@php artisan route:cache",
            "@php artisan view:cache",
            "@php artisan filament:optimize"
        ],
        "cloud:build": [
            "sh scripts/cloud-build.sh"
        ],
        "cloud:deploy": [
            "sh scripts/cloud-deploy.sh"
        ],
        "cloud:setup": [
            "sh scripts/cloud-setup.sh"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
