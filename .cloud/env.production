# Committed, non-secret production configuration for a Laravel Cloud environment.
#
# This is a starting point — edit the app-specific lines (APP_NAME, APP_DESCRIPTION,
# locales, MAIL_FROM_*) and delete what you do not use. The comments explain the
# non-obvious choices; keep them, because every one of them is a trap somebody
# already fell into.
#
# Secrets are named here with the value REPLACE_IN_DASHBOARD and pasted into the
# Cloud dashboard once. cloud-setup.sh skips those keys rather than writing them:
# setting the literal placeholder is worse than leaving a key unset — config
# validation cannot tell "unset" from "set wrong" — and on a re-run it would
# overwrite the real secret.
#
# Deliberately absent, do not add:
#   APP_KEY          cloud-setup.sh generates it on first run.
#   APP_URL          derived from the live environment; a committed value goes
#                    stale the moment a domain is added.
#   DB_*, AWS_*      Laravel Cloud injects these when a database or bucket is
#                    attached. Declaring them overrides working values with
#                    stale ones.
#   FILESYSTEM_DISK  same reason. Attaching a bucket injects the right value;
#                    a declared one would shadow it.

APP_NAME="Acme"
APP_ENV=production
APP_DEBUG=false
APP_DESCRIPTION="Change me."

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# cache, not the default file driver: `file` writes a flag to local disk, which
# is not shared between replicas and does not survive a deploy, so maintenance
# mode would apply to one container and not the others.
APP_MAINTENANCE_DRIVER=cache

# No public self-signup. config/fortify.php defaults this to false, so omitting
# the line is also safe — it is stated explicitly because it is worth seeing.
# Set to true only if the app genuinely wants open registration.
ALLOW_REGISTRATION=false

BCRYPT_ROUNDS=12

# stderr, not the default stack/single: Cloud captures stdout and stderr, and
# storage/logs neither survives a deploy nor appears in Cloud's log viewer.
LOG_CHANNEL=stderr
LOG_DEPRECATIONS_CHANNEL=null

LOG_LEVEL=warning

# ---------------------------------------------------------------------------
# MAIL_* is deliberately not set here. Choose a mailer per app rather than
# inheriting one — but if you choose `log`, read this first.
#
# The `log` mailer writes the rendered message at DEBUG level, so the
# LOG_LEVEL=warning above would silently discard every message: Mail::send
# reports success, nothing errors, and the mail simply does not exist. That
# bites hardest on the deploy where you are relying on it — a feedback deploy
# with no SMTP, where "the generated password lands in the log" is the plan.
#
#   MAIL_MAILER=log  → you must also set LOG_LEVEL=debug
#   MAIL_MAILER=smtp → leave LOG_LEVEL alone and fill the credentials below
#
# MAIL_USERNAME and MAIL_PASSWORD are secrets: name them here with the value
# REPLACE_IN_DASHBOARD and paste the real values into the Cloud dashboard.
# ---------------------------------------------------------------------------

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log

# Fixed per environment, and never derived from APP_KEY: the default IS APP_KEY,
# so rotating that key would invalidate every registered passkey.
PASSKEYS_USER_HANDLE_SECRET=REPLACE_IN_DASHBOARD

VITE_APP_NAME="${APP_NAME}"
