APP_NAME="Laravel"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Meta description + Open Graph/Twitter share description. Keep under ~160 chars.
APP_DESCRIPTION="A Laravel application."

# Stable secret for passkey (WebAuthn) user handles. Empty = derive from APP_KEY.
# Set a fixed random value in production so rotating APP_KEY does not lock users
# out of their passkeys. Generate: php -r "echo bin2hex(random_bytes(32));"
PASSKEYS_USER_HANDLE_SECRET=

# imanghafoori/laravel-anypass config, you can sign in with any password
# to test a failing password use 1_wrong_pass
ANY_PASS=true
WRONG_ANY_PASS=1_wrong_pass

# Public registration. Defaults to on everywhere except production, so a
# production environment that forgets to declare it gets no signup rather than
# open signup. Set explicitly to be sure either way.
ALLOW_REGISTRATION=true

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Postgres, always (docs/adr/0016). These are DBngin's defaults. `composer create-project`
# renames DB_DATABASE after the project folder; a worktree gets its own from Herd.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=laravel_starter_kit
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Page data in browser history is encrypted (docs/adr/0018). Needs HTTPS or localhost.
INERTIA_ENCRYPT_HISTORY=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

TELEGRAM_API_BASE=https://api.telegram.org
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_MESSAGE_THREAD_ID=

VITE_APP_NAME="${APP_NAME}"

# Demo Data Artificial Latency (ms, 0 = disabled)
# On by default so the demo pages show what a real network does: each page draws at once and
# its sections fill in as their deferred data arrives (docs/adr/0019). Ignored in the testing
# environment. Set them to 0 for an instant demo, or delete them with the demo pages.
DEMO_LATENCY_KPIS_MS=600
DEMO_LATENCY_CHARTS_MS=1200
DEMO_LATENCY_TABLE_MS=1500
DEMO_LATENCY_FEED_MS=2000
DEMO_LATENCY_DETAIL_MS=800
